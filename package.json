{
  "name": "biomerra-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @biomerra-ui/react && npm run build -w @biomerra-ui/tokens",
    "build:react": "npm run build -w @biomerra-ui/react",
    "build:tokens": "npm run build -w @biomerra-ui/tokens",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "storybook": "^8.3.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
