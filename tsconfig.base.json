{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@biomerra-ui/tokens": ["packages/tokens/src"],
      "@biomerra-ui/tokens/*": ["packages/tokens/src/*"],
      "@biomerra-ui/react": ["packages/react/src"],
      "@biomerra-ui/react/*": ["packages/react/src/*"],
      "@/*": ["packages/react/src/*"],
      "@react/*": ["packages/react/src/*"],
      "@tokens/*": ["packages/tokens/src/*"]
    }
  }
}
